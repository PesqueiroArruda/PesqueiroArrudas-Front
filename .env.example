# Public backend URL shared by HTTP and Socket.IO. Rebuild after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Supabase project used only for the external "reservations" table (institutional site's bookings).
# Server-only — never prefix with NEXT_PUBLIC_, the browser must never receive the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the Cloudflare R2 bucket used by the digital menu — only used to preview
# a product's current cardápio image in the Estoque screen. Same value as the backend's
# R2_PUBLIC_BASE_URL; no secret involved, safe to expose to the browser.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
